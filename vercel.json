{
  "version": 2,
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/login", "dest": "/api/automations.py" },
    { "src": "/api/automations", "dest": "/api/automations.py" },
    { "src": "/api/automations/(.*)", "dest": "/api/automations.py" },
    { "src": "/api/lists", "dest": "/api/automations.py" },
    { "src": "/api/campaigns", "dest": "/api/automations.py" },
    { "src": "/api/forms", "dest": "/api/automations.py" },
    { "src": "/api/properties", "dest": "/api/automations.py" },
    { "src": "/api/contacts/(.*)", "dest": "/api/automations.py" },
    { "src": "/api/slack/channels", "dest": "/api/automations.py" },
    { "src": "/api/activity", "dest": "/api/automations.py" },
    { "src": "/api/logs/(.*)", "dest": "/api/automations.py" },
    { "src": "/api/pipelines", "dest": "/api/automations.py" },
    { "src": "/api/google/service-account-email", "dest": "/api/automations.py" },
    { "src": "/api/google/connected-accounts", "dest": "/api/automations.py" },
    { "src": "/api/google/debug", "dest": "/api/automations.py" },
    { "src": "/api/google/oauth/callback", "dest": "/api/google_oauth_callback.py" },
    { "src": "/api/google/oauth", "dest": "/api/google_oauth.py" },
    { "src": "/api/gsheet/(.*)", "dest": "/api/gsheet.py" },
    { "src": "/api/sync_gsheet", "dest": "/api/sync_gsheet.py" },
    { "src": "/api/sync", "dest": "/api/sync.py" },
    { "src": "/api/sync_clay", "dest": "/api/sync_clay.py" },
    { "src": "/api/sync_fb", "dest": "/api/sync_fb.py" },
    { "src": "/api/sync_gcal", "dest": "/api/sync_gcal.py" },
    { "src": "/api/sync_gform", "dest": "/api/sync_gform.py" },
    { "src": "/webhook/calendly", "dest": "/api/calendly_webhook.py" },
    { "src": "/webhook/instantly", "dest": "/api/instantly_webhook.py" },
    { "src": "/webhook", "dest": "/api/webhook.py" },
    { "src": "/status", "dest": "/api/webhook.py" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
